{
  "id": "googlechatpubsub",
  "kind": "channel",
  "name": "Google Chat Pub/Sub Listener",
  "description": "Listen to Google Chat spaces via Workspace Events + Pub/Sub \u2014 no @mention required. Multi-agent routing with keyword and alwaysListen support.",
  "version": "0.8.0",
  "entry": "dist/index.js",
  "channels": [
    "googlechatpubsub"
  ],
  "channelConfigs": {
    "googlechatpubsub": {
      "label": "Google Chat (Pub/Sub)",
      "description": "Passive Google Chat listening via Workspace Events + Pub/Sub",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "projectId": {
            "type": "string",
            "description": "GCP project ID"
          },
          "topicId": {
            "type": "string",
            "description": "Pub/Sub topic ID"
          },
          "subscriptionId": {
            "type": "string",
            "description": "Pub/Sub subscription ID"
          },
          "pollIntervalSeconds": {
            "type": "integer",
            "minimum": 1,
            "default": 3,
            "maximum": 300
          },
          "renewalBufferMinutes": {
            "type": "integer",
            "minimum": 1,
            "default": 30,
            "maximum": 60
          },
          "agentTimeoutSeconds": {
            "type": "integer",
            "minimum": 10,
            "default": 60,
            "maximum": 3600,
            "description": "Request cancellation on timeout and wait for the run to settle before starting another."
          },
          "serviceAccountFile": {
            "type": "string",
            "description": "Path to Google Chat bot service account JSON (falls back to channels.googlechat.serviceAccountFile)"
          },
          "crossAgentDispatch": {
            "type": "boolean",
            "default": false,
            "description": "When true, agent replies mentioning other agents' keywords trigger automatic cross-dispatch to those agents."
          },
          "silentReply": {
            "type": "boolean",
            "default": true,
            "description": "Suppress the legacy static typing message. progress.enabled takes precedence."
          },
          "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clientId": {
                "type": "string"
              },
              "clientSecret": {
                "type": "string"
              },
              "redirectUri": {
                "type": "string"
              },
              "tokensFile": {
                "type": "string"
              }
            },
            "required": [
              "clientId",
              "clientSecret",
              "tokensFile"
            ]
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "space": {
                  "type": "string",
                  "description": "Google Chat space name (e.g. spaces/ABC123example)",
                  "pattern": "^spaces/[A-Za-z0-9_-]+$"
                },
                "replyInThread": {
                  "type": "boolean",
                  "default": false,
                  "description": "When true, reply in the incoming thread. When false (default), post directly in the space and ignore incoming or supplied thread context."
                },
                "threadSessionIsolation": {
                  "type": "boolean",
                  "description": "When true, each thread gets its own session. Defaults to replyInThread."
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "agentId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,80}$"
                      },
                      "mentionKeyword": {
                        "type": "string"
                      },
                      "alwaysListen": {
                        "type": "boolean",
                        "default": false
                      }
                    },
                    "required": [
                      "agentId"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 10
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^users/[0-9]+$"
                  },
                  "uniqueItems": true,
                  "maxItems": 1000,
                  "description": "Allowed human sender IDs. A space override replaces the global list."
                },
                "allowAllSpaceMembers": {
                  "type": "boolean",
                  "default": false,
                  "description": "Explicitly admit all human members of a bound space."
                },
                "commandAllowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^users/[0-9]+$"
                  },
                  "uniqueItems": true,
                  "maxItems": 1000,
                  "description": "Admitted users allowed to invoke commands; empty by default. Host policy still applies."
                }
              },
              "required": [
                "space",
                "agents"
              ]
            },
            "minItems": 1,
            "maxItems": 100
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^users/[0-9]+$"
            },
            "uniqueItems": true,
            "maxItems": 1000,
            "description": "Allowed human sender IDs. A space override replaces the global list."
          },
          "allowAllSpaceMembers": {
            "type": "boolean",
            "default": false,
            "description": "Explicitly admit all human members of a bound space."
          },
          "commandAllowFrom": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^users/[0-9]+$"
            },
            "uniqueItems": true,
            "maxItems": 1000,
            "description": "Admitted users allowed to invoke commands; empty by default. Host policy still applies."
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "service-account",
                  "user-oauth"
                ],
                "description": "Defaults to user-oauth if oauth is configured; otherwise service-account."
              }
            },
            "required": [
              "mode"
            ]
          },
          "reactionsEnabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable reaction actions (requires user-oauth)."
          },
          "maxPendingMessages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200,
            "description": "Includes failed records awaiting review; a full inbox prevents ACK."
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inboundEnabled": {
                "type": "boolean",
                "default": false
              },
              "outboundEnabled": {
                "type": "boolean",
                "default": false,
                "description": "Requires user-oauth."
              },
              "allowRemoteUrls": {
                "type": "boolean",
                "default": false,
                "description": "Allow public HTTPS media URLs with DNS/redirect checks."
              },
              "localRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Absolute allowed roots when the host does not supply an authorized media reader. Symlinks and hardlinks are rejected."
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 209715200,
                "default": 20971520
              },
              "maxAttachments": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 5
              },
              "retentionHours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 168,
                "default": 24
              }
            }
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "description": "One editable activity message per agent run, replaced by the final reply. Takes precedence over silentReply.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "updateIntervalSeconds": {
                "type": "integer",
                "minimum": 2,
                "maximum": 30,
                "default": 5,
                "description": "Minimum time between activity edits; unchanged text is not sent again."
              },
              "maxRecentActivities": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8,
                "default": 3
              },
              "includeDetails": {
                "type": "boolean",
                "default": true,
                "description": "Show bounded tool-provided titles and search queries. Disable for tool names/counts only. Never forwards commands, tool output, or reasoning."
              }
            }
          }
        },
        "required": []
      },
      "uiHints": {
        "enabled": {
          "label": "Enable Pub/Sub Listener"
        },
        "projectId": {
          "label": "GCP Project ID",
          "placeholder": "my-gcp-project"
        },
        "oauth.clientId": {
          "label": "OAuth Client ID"
        },
        "oauth.clientSecret": {
          "label": "OAuth Client Secret",
          "sensitive": true
        },
        "oauth.tokensFile": {
          "label": "OAuth Tokens File Path"
        },
        "auth.mode": {
          "label": "Authentication mode"
        },
        "allowFrom": {
          "label": "Allowed user IDs"
        },
        "commandAllowFrom": {
          "label": "Command user IDs"
        },
        "serviceAccountFile": {
          "label": "Service account key file"
        },
        "media.outboundEnabled": {
          "label": "Allow uploads (user OAuth only)"
        }
      }
    }
  },
